{
  "name": "comvenio-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Comvenio Club-CLI for authenticated club management and automation.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "bin": {
    "comvenio": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile comvenio",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "gen:schema": "bun run scripts/gen-schema.ts",
    "gen:schema:check": "bun run scripts/gen-schema.ts --check",
    "gen:coverage": "bun run scripts/gen-coverage.ts",
    "gen:coverage:check": "bun run scripts/gen-coverage.ts --check",
    "gen:connector-inventory": "bun run scripts/import-connector-inventory.ts",
    "gen:connector-inventory:check": "bun run scripts/import-connector-inventory.ts --check",
    "gen:openai-submission:check": "bun run scripts/validate-openai-submission.ts",
    "gen:anthropic-submission:check": "bun run scripts/validate-anthropic-submission.ts",
    "gen:api": "echo 'Placeholder — per service: openapi-typescript https://api.comvenio.app/{service}/openapi.json -o src/api/{service}.ts (Folge-Straenge comvenio-cli-04..09)'"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@comvenio/comvenio-client": "workspace:*",
    "@comvenio/connector-contracts": "workspace:*",
    "@comvenio/tool-catalog": "workspace:*",
    "@types/bun": "^1.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.4.0"
  }
}
