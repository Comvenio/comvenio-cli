{
  "name": "@comvenio/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless Streamable HTTP runtime for the remote Comvenio MCP connector.",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test tests",
