        "label": "Mehr",
        "href": "?tab=verein"
      },
      "style": "knopf-gold"
    }
  },
  "styles": [
    {
      "id": "knopf-gold",
      "label": "Knopf gold",
      "class": "gold",
      "fuer": [
        "link"
      ]
    }
  ],
  "erwartet": []
}
